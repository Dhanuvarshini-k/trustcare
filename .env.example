# TrustCare CDSS Environment Configuration Template
# Copy this file to .env and insert your actual credentials:
#   copy .env.example .env

# Hugging Face API Token (for BioMistral inference router)
HF_TOKEN=your_huggingface_token_here
HUGGINGFACE_API_KEY=your_huggingface_token_here

# NCBI PubMed API Configuration (for PubMed literature retrieval)
NCBI_API_KEY=your_ncbi_api_key_here
NCBI_EMAIL=your_email_here@example.com

# Tavily Search API Key (for real-time ACC/AHA guideline scanning)
TAVILY_API_KEY=your_tavily_api_key_here

# Google Gemini API Key (for LLM reasoning fallback if configured)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=cardiac_abstracts

# Embedding Model (Hugging Face / SentenceTransformers)
EMBEDDING_MODEL=pritamdeka/S-PubMedBert-MS-MARCO

# RAG Retrieval Hyperparameters
RAG_TOP_K=5
RAG_MIN_SCORE=0.35
